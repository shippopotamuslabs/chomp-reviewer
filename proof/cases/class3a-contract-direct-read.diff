 """Billing: invoices rendered from fetched orders."""
 
+import sqlite3
+
 from src.helpers import format_money
 from src.store import fetch_order
 
 
+
+def quick_total(order_id):
+    """Fast path for the dashboard: read the total directly."""
+    connection = sqlite3.connect("orders.db")
+    row = connection.execute(
+        "SELECT total FROM orders WHERE id = ?", (order_id,)
+    ).fetchone()
+    return row[0] if row else 0.0
+
